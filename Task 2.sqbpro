"1" value="176"/><column index="2" value="91"/><column index="3" value="135"/><column index="4" value="64"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="40"/><column index="2" value="35"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Create">/* ---Vehicle Table---*/
CREATE TABLE IF NOT EXISTS Vehicle
(
Vehicle_Registration_Number TEXT NOT NULL,
Vehicle_Colour TEXT NOT NULL,
Vehicle_Make TEXT NOT NULL,
Driver_ID TEXT NOT NULL,
 PRIMARY KEY(Vehicle_Registration_Number),
 FOREIGN KEY (Driver_ID) REFERENCES Driver(Driver_ID) ON DELETE CASCADE ON UPDATE CASCADE
);

/* ---Payment Table---*/
CREATE TABLE IF NOT EXISTS Payment
(
Payment_ID TEXT NOT NULL,
Journey_ID TEXT NOT NULL,
Journey_Time TEXT NOT NULL,
Cost_Of_Trip DOUBLE(2) NOT NULL,
Payment_Method TEXT NOT NULL,
 PRIMARY KEY(Payment_ID),
 FOREIGN KEY (Journey_ID) REFERENCES Journey(Journey_ID) ON DELETE CASCADE ON UPDATE CASCADE
);

/*---Rating Type Table---*/
CREATE TABLE IF NOT EXISTS Rating_Type
(
Rating_Type_ID TEXT NOT NULL,
Rating_Type TEXT NOT NULL,
PRIMARY KEY (Rating_Type_ID)
);

/*---Rating Table---*/
CREATE TABLE IF NOT EXISTS Rating
(
Rating_ID TEXT NOT NULL,
Journey_ID INT NOT NULL,
User_Role TEXT NOT NULL,
Rating_Type_ID TEXT NOT NULL,
Rating DOUBLE(2) NOT NULL,
PRIMARY KEY (Rating_ID)
FOREIGN KEY (Journey_ID) REFERENCES Journey(Journey_ID) ON DELETE CASCADE ON UPDATE CASCADE
FOREIGN KEY (Rating_Type_ID) REFERENCES Rating_Type(Rating_Type_ID) ON DELETE CASCADE ON UPDATE CASCADE
);</sql><sql name="Insert">INSERT OR IGNORE INTO Vehicle(Vehicle_Registration_Number, Vehicle_Colour, Vehicle_Make, Driver_ID)
