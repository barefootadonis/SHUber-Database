/*--Update Journey Table--*/
UPDATE Journey
SET Cust_Rating = (
    SELECT ROUND(AVG(Rating), 2)
    FROM Rating
    WHERE Rating.Journey_ID = Journey.Journey_ID
      AND Rating.User_Role = 'Driver'
)
WHERE Journey_ID IN (
    SELECT Journey_ID
    FROM Rating
    WHERE User_Role = 'Driver'
);
UPDATE Journey
SET Driver_Rating = (
    SELECT ROUND(AVG(Rating), 2)
    FROM Rating
    WHERE Rating.Journey_ID = Journey.Journey_ID
      AND Rating.User_Role = 'Customer'
)
WHERE Journey_ID IN (
    SELECT Journey_ID
    FROM Rating
    WHERE User_Role = 'Customer'
);

/*--Update Customer Table--*/
UPDATE Customer
SET Cust_Avg_Rate = (
    SELECT ROUND(AVG(j.Cust_Rating), 2)
    FROM Journey j
    WHERE j.Cust_ID = Customer.Cust_ID
)
WHERE Cust_ID IN (
    SELECT Cust_ID
    FROM Journey
    WHERE Cust_Rating IS NOT NULL
);

/*--Update Driver Table--*/
UPDATE Driver
SET Driver_Avg_Rate = (
    SELECT ROUND(AVG(j.Driver_Rating), 2)
    FROM Journey j
    WHERE j.Driver_ID = Driver.Driver_ID
)
WHERE Driver_ID IN (
    SELECT Driver_ID
    FROM Journey
    WHERE Driver_Rating IS NOT NULL
);
</sql><sql name="Task 4 a">SELECT d.Driver_Fname ||' '|| d.Driver_Lname AS &quot;Driver Name&quot;, COUNT(j.Journey_ID) AS &quot;No. of Journeys&quot;
FROM Driver d
INNER JOIN Journey j ON (d.Driver_ID = j.Driver_ID)
WHERE j.Driver_Rating &gt;= 4.5
GROUP BY d.Driver_Fname, d.Driver_Lname
ORDER BY COUNT(j.Journey_ID) DESC
LIMIT 5;
</sql><sql name="Task 4 b">SELECT c.Cust_Fname ||' '|| c.Cust_Lname AS &quot;Customer Name&quot;, COUNT(j.Journey_ID) AS &quot;No. of Journeys&quot;, AVG(p.Cost_Of_Trip) AS &quot;Average Spending&quot;
FROM Customer c
INNER JOIN Journey j ON (c.Cust_ID = j.Cust_ID)
INNER JOIN Payment p ON (j.Journey_ID = p.Journey_ID)
GROUP BY c.Cust_Fname, c.Cust_Lname
HAVING AVG(p.Cost_Of_Trip) &gt;= 100.00 AND MIN(j.Cust_Rating) = 5
ORDER BY COUNT(j.Journey_ID) DESC
LIMIT 5;
</sql><current_tab id="2"/></tab_sql></sqlb_project>
